<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WhatFont.ViewModels"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="640"
        x:Class="WhatFont.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="啥字儿"
        Icon="/Assets/whatfont.ico"
        Width="560" Height="680"
        MinWidth="560" MaxWidth="560" MinHeight="420"
        CanMaximize="False"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44"
        RequestedThemeVariant="Light"
        Background="Transparent"
        Opened="OnOpened">

    <Window.Styles>
        <Style Selector="Button.caption">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.caption /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#10000000"/>
        </Style>
        <Style Selector="Button.caption:pointerpressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#1C000000"/>
        </Style>
        <Style Selector="Button.captionClose /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.captionClose:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E81123"/>
        </Style>
        <Style Selector="Button.captionClose:pointerover Path">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Stroke" Value="White"/>
        </Style>
        <Style Selector="Border.fontCard:pointerover">
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#30000000"/>
        </Style>
        <Style Selector="Button.copyName">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.copyName /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.copyName:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#0A000000"/>
        </Style>
        <Style Selector="Button.copyName:pointerpressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#12000000"/>
        </Style>
        <Style Selector="ScrollViewer.fontListScroll /template/ ScrollBar#PART_VerticalScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Margin" Value="0,4,2,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="ScrollViewer.fontListScroll /template/ ScrollBar#PART_VerticalScrollBar /template/ Grid#Root">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ScrollViewer.fontListScroll /template/ ScrollBar#PART_VerticalScrollBar /template/ Border#VerticalRoot">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="ScrollViewer.fontListScroll /template/ ScrollBar#PART_VerticalScrollBar /template/ Rectangle#TrackRect">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="ScrollViewer.fontListScroll /template/ ScrollBar#PART_VerticalScrollBar /template/ RepeatButton#PART_LineUpButton">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ScrollViewer.fontListScroll /template/ ScrollBar#PART_VerticalScrollBar /template/ RepeatButton#PART_LineDownButton">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ScrollViewer.fontListScroll /template/ ScrollBar#PART_VerticalScrollBar /template/ Thumb">
            <Setter Property="Width" Value="5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Background" Value="#66000000"/>
            <Setter Property="RenderTransform" Value="none"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ScrollViewer.fontListScroll.scrolling /template/ ScrollBar#PART_VerticalScrollBar /template/ Thumb">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="ScrollViewer.fontListScroll /template/ ScrollBar#PART_VerticalScrollBar /template/ Thumb:pointerover">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Background" Value="#85000000"/>
        </Style>
        <Style Selector="ScrollViewer.fontListScroll /template/ ScrollBar#PART_VerticalScrollBar /template/ Thumb:pressed">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Background" Value="#A0000000"/>
        </Style>
    </Window.Styles>

    <Panel>
        <Grid RowDefinitions="44,*" Background="#B8F4F6FA">
            <Grid Grid.Row="0"
                  chrome:WindowDecorationProperties.ElementRole="TitleBar"
                Background="Transparent">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Width="16" Height="16" Source="/Assets/whatfont.ico" Stretch="Uniform"/>
                    <TextBlock Text="啥字儿" FontSize="13" Foreground="#E61A1C20"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Classes="caption"
                            chrome:WindowDecorationProperties.ElementRole="DecorationsElement"
                            Click="OnMinimizeClick"
                            ToolTip.Tip="最小化">
                        <Path Width="10" Height="10" StrokeThickness="1.2"
                              Stroke="#B81A1C20"
                              Data="M0,5 H10"/>
                    </Button>
                    <Button Classes="caption captionClose"
                            chrome:WindowDecorationProperties.ElementRole="DecorationsElement"
                            Click="OnCloseClick"
                            ToolTip.Tip="关闭">
                        <Path Width="10" Height="10" StrokeThickness="1.2"
                              Stroke="#B81A1C20"
                              Data="M1,1 L9,9 M9,1 L1,9"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" Margin="14,6,14,10">
                <TextBox Grid.Row="0"
                         PlaceholderText="搜索 Family / PostScript / 路径"
                         Text="{Binding SearchText}"
                         Margin="8,0"
                         Height="40"
                         Padding="12,0"
                         VerticalContentAlignment="Center"
                         CornerRadius="8"
                         Foreground="#E61A1C20"
                         Background="#EFFFFFFF"
                         BorderBrush="#28000000"
                         BorderThickness="1"/>

                <ScrollViewer Grid.Row="1"
                              Classes="fontListScroll"
                              Margin="0,10,0,6"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              AllowAutoHide="True"
                              ScrollChanged="OnFontListScrollChanged">
                    <ItemsControl ItemsSource="{Binding VisibleFonts}" Margin="8,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FontItem">
                                <Border Classes="fontCard"
                                        CornerRadius="8"
                                        Padding="8,14"
                                        Margin="0,0,0,10"
                                        Background="#EFFFFFFF"
                                        BorderThickness="1"
                                        BorderBrush="#24000000"
                                        BoxShadow="0 4 12 0 #26000000">
                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                                        <Image Source="{Binding PreviewImage}"
                                               Stretch="Uniform"
                                               Height="38"
                                               MaxWidth="520"
                                               HorizontalAlignment="Left"
                                               Margin="8,0,8,3"/>
                                        <Button Grid.Row="1"
                                                Classes="copyName"
                                                Click="OnCopyFamilyClick"
                                                AutomationProperties.Name="复制 Family name"
                                                ToolTip.Tip="复制 Family name">
                                            <Grid ColumnDefinitions="48,*,18">
                                                <TextBlock Text="Family"
                                                           Foreground="#7A1A1C20"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding FamilyName}"
                                                           Foreground="#E61A1C20"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Viewbox Grid.Column="2" Width="14" Height="14"
                                                         HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Path Data="M9,9 H19 V19 H9 Z M5,15 H4 C2.9,15 2,14.1 2,13 V4 C2,2.9 2.9,2 4,2 H13 C14.1,2 15,2.9 15,4 V5"
                                                          Fill="Transparent" Stroke="#751A1C20"
                                                          StrokeThickness="1.8" StrokeLineCap="Round"
                                                          StrokeJoin="Round"/>
                                                </Viewbox>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Row="2"
                                                Classes="copyName"
                                                Click="OnCopyPostScriptClick"
                                                AutomationProperties.Name="复制 PostScript name"
                                                ToolTip.Tip="复制 PostScript name">
                                            <Grid ColumnDefinitions="48,*,18">
                                                <TextBlock Text="PS"
                                                           Foreground="#7A1A1C20"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding PostScriptName}"
                                                           FontFamily="Consolas,monospace"
                                                           Foreground="#A61A1C20"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Viewbox Grid.Column="2" Width="14" Height="14"
                                                         HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Path Data="M9,9 H19 V19 H9 Z M5,15 H4 C2.9,15 2,14.1 2,13 V4 C2,2.9 2.9,2 4,2 H13 C14.1,2 15,2.9 15,4 V5"
                                                          Fill="Transparent" Stroke="#751A1C20"
                                                          StrokeThickness="1.8" StrokeLineCap="Round"
                                                          StrokeJoin="Round"/>
                                                </Viewbox>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="2" Text="{Binding StatusText}"
                           FontSize="11" Foreground="#8F1A1C20"
                           HorizontalAlignment="Center"/>
            </Grid>
        </Grid>

        <Border x:Name="Toast"
                IsVisible="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,26"
                Padding="14,8"
                CornerRadius="10"
                Background="#E6222222">
            <TextBlock x:Name="ToastText" FontSize="12" Foreground="White"/>
        </Border>
    </Panel>
</Window>
