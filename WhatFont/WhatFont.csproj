<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\whatfont.ico</ApplicationIcon>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory Condition="'$(Configuration)' == 'Release'">false</CopyOutputSymbolsToPublishDirectory>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Speed</OptimizationPreference>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <Target Name="RemovePublishSymbols" AfterTargets="Publish">
    <ItemGroup>
      <PublishSymbols Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(PublishSymbols)" />
  </Target>

  <Target Name="CreatePortableArchive"
          AfterTargets="CopyNativeBinary"
          DependsOnTargets="RemovePublishSymbols"
          Condition="'$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <PortableArchiveName>WhatFont-$(Version)-$(RuntimeIdentifier)-portable.zip</PortableArchiveName>
      <PortableArchiveDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\Publish'))</PortableArchiveDirectory>
      <PortableArchivePath>$(PortableArchiveDirectory)\$(PortableArchiveName)</PortableArchivePath>
    </PropertyGroup>
    <MakeDir Directories="$(PortableArchiveDirectory)" />
    <ZipDirectory SourceDirectory="$(PublishDir)"
                  DestinationFile="$(PortableArchivePath)"
                  Overwrite="true" />
    <Message Importance="high" Text="Portable archive: $(PortableArchivePath)" />
  </Target>
</Project>
